# =============================================================================
# GPL Decision Analytics Engine -- environment template
# Copy to `.env` and fill in. Every key is OPTIONAL: with none set, the engine
# runs fully on the local SQLite warehouse + seeded data + regex LLM fallback.
# =============================================================================

# --- Data warehouse ---
# Leave unset for local SQLite. On GPL AWS, point at RDS Postgres:
# DATABASE_URL=postgresql+psycopg://gpl:password@gpl-rds.xxxx.rds.amazonaws.com:5432/gpl

# --- LLM text parsing (brief 5.1: prefer self-hosted) ---
# provider: regex (default, offline) | ollama (self-hosted) | anthropic
GPL_LLM_PROVIDER=regex
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- External data APIs (GPL provides these) ---
# PROPEQUITY_API_KEY=
# GOOGLE_MAPS_API_KEY=
# SALESFORCE_TOKEN=
# SALESFORCE_INSTANCE_URL=

# --- Scraping ---
GPL_LIVE_SCRAPING=false          # true to hit live MagicBricks/99acres/RERA
GPL_DEFAULT_RADIUS_KM=3.0

# --- Alerting ---
# SENDGRID_API_KEY=
# SENDGRID_FROM=alerts@godrejproperties.com
# WHATSAPP_PROVIDER=interakt
# WHATSAPP_API_KEY=
GPL_ADMIN_EMAIL=admin@godrejproperties.com
